        "id": "#VSC-1e0cc9c1",
        "language": "python"
      },
      "source": [
        "class_names = [\"cat\", \"cow\", \"dog\", \"elephant\", \"horse\"]",
        "dataset_options = {",
        "    \"target_size\": (200, 200),",
        "    \"classes\": class_names,",
        "    \"batch_size\": 10,",
        "    \"class_mode\": \"categorical\",",
        "}",
        "",
        "train_dataset = train.flow_from_directory(\"Dataset/train/\", **dataset_options)",
        "validation_dataset = validation.flow_from_directory(\"Dataset/validaction/\", **dataset_options)",
        "test_dataset = validation.flow_from_directory(\"Dataset/Test/\", **dataset_options)"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "#VSC-342d83fd",
        "language": "python"
      },
      "source": [
        "model = tf.keras.models.Sequential([",
        "    tf.keras.layers.Conv2D(16, (3, 3), activation=\"relu\", input_shape=(200, 200, 3)),",
        "    tf.keras.layers.MaxPooling2D(2, 2),",
        "    tf.keras.layers.Conv2D(32, (3, 3), activation=\"relu\"),",
        "    tf.keras.layers.MaxPooling2D(2, 2),",
        "    tf.keras.layers.Conv2D(64, (3, 3), activation=\"relu\"),",
        "    tf.keras.layers.MaxPooling2D(2, 2),",
        "    tf.keras.layers.Flatten(),",
        "    tf.keras.layers.Dense(512, activation=\"relu\"),",
        "    tf.keras.layers.Dense(5, activation=\"softmax\"),",
        "])"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "#VSC-6761071b",
        "language": "python"
      },
      "source": [
        "model.compile(loss=\"categorical_crossentropy\", optimizer=\"adam\", metrics=[\"accuracy\"])"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "#VSC-cd2c29e0",
        "language": "python"
      },
      "source": [
        "model_fit = model.fit(",
        "    train_dataset,",
        "    validation_data=validation_dataset,",
        "    epochs=10,",
        "    callbacks=[tf.keras.callbacks.CSVLogger(\"history.csv\")],",
        ")",
        "_, accuracy = model.evaluate(test_dataset, verbose=1)",
        "print(f\"Test accuracy: {accuracy * 100:.2f}%\")"
      ]
    }
  ]
}